# SafeVision — configuracion de red del robot
#
# Copia este fichero a scripts/robot.env y ajusta el valor:
#
#     cp scripts/robot.env.example scripts/robot.env
#
# scripts/robot.env esta en .gitignore: es configuracion local de cada PC
# y NO debe versionarse.

# Direccion del robot. Puede ser:
#   - un nombre mDNS:  yahboom.local        (recomendado; sobrevive a cambios de IP)
#   - una IP fija:     192.168.1.13
#
# OJO: la interfaz web del dashboard solo acepta IPv4 en su casilla de conexion,
# no nombres. run_dashboard.sh resuelve el nombre por ti y te muestra la IP
# exacta que hay que escribir.
ROBOT_HOST=yahboom.local

# Puerto del Robot Server. No cambiarlo salvo que se haya modificado
# sf_robot_server.py (PORT = 8091).
ROBOT_PORT=8091

# Puerto local del dashboard. sf_app_dashboard.py escucha en 127.0.0.1:5000.
# Solo informativo: cambiarlo aqui NO cambia el puerto real.
DASHBOARD_PORT=5000
