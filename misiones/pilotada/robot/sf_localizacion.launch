<launch>

    <arg name="map_file"/>

    <arg name="initial_pose_x" default="0.0"/>
    <arg name="initial_pose_y" default="0.0"/>
    <arg name="initial_pose_a" default="0.0"/>

    <arg name="robot_type" default="$(env ROBOT_TYPE)"/>

    <param
        name="robot_description"
        command="$(find xacro)/xacro --inorder '$(find yahboomcar_description)/urdf/yahboomcar_$(arg robot_type).urdf'"
    />

    <node
        pkg="joint_state_publisher"
        type="joint_state_publisher"
        name="joint_state_publisher"
    />

    <node
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
    />

    <node
        pkg="yahboomcar_bringup"
        type="base_node"
        name="odometry_publisher"
    >
        <param name="odom_frame" type="string" value="odom"/>
        <param name="base_footprint_frame" type="string" value="base_footprint"/>
        <param name="linear_scale_x" type="double" value="0.98"/>
        <param name="linear_scale_y" type="double" value="1.0"/>

        <remap from="/sub_vel" to="/vel_raw"/>
        <remap from="/pub_odom" to="/odom_raw"/>
    </node>

    <!-- Calibracion IMU Yahboom -->
    <node
        pkg="imu_calib"
        type="apply_calib"
        name="apply_calib"
        output="screen"
        respawn="false"
    >
        <param
            name="calib_file"
            value="$(find yahboomcar_bringup)/param/imu_calib.yaml"
        />

        <param
            name="calibrate_gyros"
            value="true"
        />

        <remap
            from="/sub_imu"
            to="/imu/imu_raw"
        />

        <remap
            from="/sub_mag"
            to="/mag/mag_raw"
        />

        <remap
            from="/pub_imu"
            to="/imu/imu_calib"
        />

        <remap
            from="/pub_mag"
            to="/mag/mag_calib"
        />
    </node>

    <node
        pkg="imu_filter_madgwick"
        type="imu_filter_node"
        name="imu_filter_madgwick"
        output="screen"
    >
        <param name="fixed_frame" value="base_link"/>
        <param name="use_mag" value="true"/>
        <param name="publish_tf" value="false"/>
        <param name="use_magnetic_field_msg" value="true"/>
        <param name="world_frame" value="enu"/>
        <param name="orientation_stddev" value="0.05"/>
        <param name="angular_scale" value="1.00"/>

        <remap from="/sub_imu" to="/imu/imu_calib"/>
        <remap from="/sub_mag" to="/mag/mag_calib"/>
        <remap from="/pub_imu" to="/imu/imu_data"/>
        <remap from="/pub_mag" to="/mag/mag_field"/>
    </node>

    <node
        pkg="robot_localization"
        type="ekf_localization_node"
        name="ekf_localization"
        output="screen"
    >
        <remap from="odometry/filtered" to="odom"/>
        <remap from="/imu0" to="/imu/imu_data"/>
        <remap from="/odom0" to="odom_raw"/>

        <param name="odom_frame" value="/odom"/>
        <param name="world_frame" value="/odom"/>
        <param name="base_link_frame" value="/base_footprint"/>

        <rosparam
            command="load"
            file="$(find yahboomcar_bringup)/param/robot_localization.yaml"
        />
        <!-- SAFERVISION_EKF_IMU_NO_VYAW
             Conserva yaw Madgwick pero evita fusionar el gyro Z
             con bias residual como segunda fuente angular IMU. -->
        <rosparam param="imu0_config">
            [false, false, false,
             true,  true,  true,
             false, false, false,
             true,  true,  false,
             false, false, false]
        </rosparam>

        <!-- SafeVision: conserva IMU diferencial y desactiva solo vyaw -->
        <param name="imu0_differential" value="true"/>
        <param name="imu0_relative" value="false"/>


    </node>

    <node
        pkg="rplidar_ros"
        type="rplidarNode"
        name="rplidarNode"
        output="screen"
    >
        <param name="serial_port" type="string" value="/dev/rplidar"/>
        <param name="serial_baudrate" type="int" value="115200"/>
        <param name="frame_id" type="string" value="laser"/>
        <param name="inverted" type="bool" value="false"/>
        <param name="angle_compensate" type="bool" value="true"/>
    </node>

    <node
        pkg="tf"
        type="static_transform_publisher"
        name="base_link_to_laser"
        args="0.0435 0.0 0.11 3.1416 0 0 /base_link /laser 30"
    />

    <node
        pkg="map_server"
        type="map_server"
        name="sf_map_server"
        args="$(arg map_file)"
    />

    <include
        file="$(find yahboomcar_nav)/launch/library/amcl.launch"
    >
        <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
        <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
        <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
        <arg name="odom_model_type" value="omni"/>
    </include>

    <!-- SafeVision: AMCL mas reactivo para seguimiento pilotado -->
    <param name="/amcl/update_min_d" value="0.10"/>
    <param name="/amcl/update_min_a" value="0.10"/>

</launch>
