<launch>

    <param
        name="use_sim_time"
        value="false"
    />

    <node
        name="joy_node"
        pkg="joy"
        type="joy_node"
        output="screen"
        respawn="false"
    />

    <node
        name="yahboom_joy"
        pkg="yahboomcar_ctrl"
        type="yahboom_joy.py"
        output="screen"
    >
        <!-- yahboom_joy.py lee xspeed_limit/yspeed_limit; antes se pasaba
             linear_speed_limit, que el nodo ignoraba. Mismos valores que sus
             defectos: la reduccion fina se hace en el selector
             (/runtime/speed, pagina Pilotada). -->
        <param
            name="xspeed_limit"
            type="double"
            value="1.0"
        />

        <param
            name="yspeed_limit"
            type="double"
            value="1.0"
        />

        <param
            name="angular_speed_limit"
            type="double"
            value="5.0"
        />

        <remap
            from="cmd_vel"
            to="/cmd_vel_manual"
        />
    </node>

</launch>
